# ─────────────────────────────────────────────────────────────
# RecoveryAI configuration
# Copy to .env and adjust. Every value below has a safe default;
# the system runs standalone with an entirely empty .env.
# ─────────────────────────────────────────────────────────────

# ── LLM provider ──────────────────────────────────────────────
# Every case is decided by the model — there is no policy-table fallback.
# Leave GEMINI_API_KEY empty and the agent defers each case instead of
# guessing; nothing crashes, but nothing progresses either.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-2.5-pro and gemini-2.5-flash return 404 ("no longer available to
# new users") for keys created after their cutoff, despite still appearing
# in ListModels. Flash-lite is the current default with headroom to spare.
LLM_MODEL=gemini-3.5-flash-lite

# Rate/cost governance. Provider-agnostic: point these at whatever your
# enterprise LLM allows. The free tier's real ceiling is per-model and often
# far lower than either of these — check your model's actual quota before
# relying on the numbers below.
LLM_MAX_RPM=4
LLM_MAX_RPD=90
LLM_TIMEOUT_SECONDS=30

# ── Agent behaviour ───────────────────────────────────────────
# live   = decided actions are dispatched to the executor
# shadow = agent reasons and logs everything, dispatches nothing.
#          Use this to pilot against real traffic before going live.
AGENT_MODE=live

# How a decided action is carried out.
#   simulated = built-in fake executor (default, zero dependencies)
#   webhook   = POST the signed ActionIntent to ACTION_WEBHOOK_URL
#   razorpay  = turn the intent into a real Razorpay test-mode Payment Link
ACTION_EXECUTOR=simulated
ACTION_WEBHOOK_URL=
ACTION_WEBHOOK_TIMEOUT_SECONDS=10

# Delay before an unresolved case is re-evaluated, scaled per case by how
# much is still expected to be recovered (see core/economics.py) — a P0 case
# is revisited 4x as often as this, a P3 case at half the rate. Default is
# the real retry cadence, not a demo-compressed one; use POST
# /api/v1/dev/followups/run or /api/v1/dev/cases/{id}/advance to step a case
# forward without waiting.
FOLLOWUP_DELAY_SECONDS=14400

# How many decisions a case gets before being handed to a human. Per
# vertical, not configured here — see max_steps in core/verticals/*.py.

# ── Ingestion security ────────────────────────────────────────
# HMAC-SHA256 over the raw request body, hex-encoded.
# Leave the secret empty to disable verification (local dev only).
WEBHOOK_SIGNING_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-RecoveryAI-Signature

# ── API security ──────────────────────────────────────────────
# Comma-separated. Empty list disables auth entirely (local dev only).
API_KEYS=
API_KEY_HEADER=X-API-Key
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Storage ───────────────────────────────────────────────────
DATABASE_URL=

# ── Demo simulator ────────────────────────────────────────────
# Autonomous event generation so the console has live traffic.
# Turn off when driving the agent from a real event source.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=6.0

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true

# ── Escalation notifications (optional) ──────────────────────
# Empty means nothing is ever sent. Set an incoming-webhook URL to have the
# agent announce every handoff to a human.
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=5

# ── Razorpay (optional) ──────────────────────────────────────
# Only read when ACTION_EXECUTOR=razorpay above.
# Test-mode keys (rzp_test_*) are accepted as-is; anything else is refused
# unless RAZORPAY_ALLOW_LIVE=true, so a production .env cannot quietly start
# sending real payment links to real customers.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ALLOW_LIVE=false
RAZORPAY_CALLBACK_URL=
RAZORPAY_TIMEOUT_SECONDS=15
